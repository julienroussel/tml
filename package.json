{
  "name": "tml",
  "version": "0.1.0",
  "private": true,
  "description": "The Magic Lab",
  "homepage": "https://github.com/julienroussel/tml#readme",
  "bugs": {
    "url": "https://github.com/julienroussel/tml/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julienroussel/tml.git"
  },
  "author": "Julien Roussel",
  "type": "module",
  "scripts": {
    "prebuild": "pnpm run powersync:assets && tsx scripts/generate-llms-txt.ts",
    "build": "next build",
    "postbuild": "tsx scripts/check-bundle-secrets.ts && tsx scripts/check-powersync-assets.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "predev": "tsx scripts/generate-llms-txt.ts",
    "dev": "next dev --experimental-https",
    "docs:generate": "tsx scripts/generate-docs.ts",
    "email:dev": "email dev --dir src/emails --port 3030",
    "fix": "ultracite fix",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "postinstall": "pnpm run powersync:assets",
    "lint": "ultracite check",
    "powersync:assets": "powersync-web copy-assets -o public && rm -rf public/powersync && mv public/@powersync public/powersync",
    "prepare": "lefthook install",
    "reset:dev-branch": "tsx --env-file-if-exists=.env.local scripts/reset-dev-branch.ts",
    "screenshots": "tsx scripts/generate-screenshots.ts",
    "setup": "tsx scripts/setup.ts",
    "start": "next start",
    "sync:check": "tsx scripts/check-sync.ts",
    "sync:check:grants": "tsx scripts/check-grants.ts",
    "sync:deploy": "tsx scripts/powersync.ts deploy sync-config",
    "sync:generate": "tsx scripts/generate-sync.ts",
    "sync:validate": "tsx scripts/powersync.ts validate --validate-only=sync-config",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@hookform/resolvers": "5.7.1",
    "@journeyapps/wa-sqlite": "2.0.0",
    "@neondatabase/auth": "0.4.2-beta",
    "@neondatabase/serverless": "1.1.0",
    "@powersync/common": "2.0.0",
    "@powersync/kysely-driver": "2.0.0",
    "@powersync/react": "2.0.0",
    "@powersync/web": "2.0.0",
    "@react-email/render": "2.1.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/firewall": "1.2.2",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "lucide-react": "1.28.0",
    "next": "16.2.12",
    "next-intl": "4.13.4",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "resend": "6.18.1",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "web-push": "3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "1.62.1",
    "@react-email/preview-server": "5.2.10",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/culori": "4.0.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "culori": "4.0.2",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "jsdom": "30.0.1",
    "lefthook": "2.1.10",
    "powersync": "0.10.0",
    "react-email": "6.9.1",
    "shadcn": "4.16.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "ultracite": "7.10.0",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=10"
  }
}
